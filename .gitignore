# Screenshots the browser test drops on every run. CI uploads them as a
# build artifact instead — see .github/workflows/games-ci.yml.
.ci-shots/

# The site has no dependencies and neither does its test suite. The only
# thing that ever lands in here is playwright, installed with --no-save to
# run the browser tests, so the whole directory is disposable. It used to
# be half committed for a little express backend that no longer exists.
node_modules/
package-lock.json

# editors and the operating system leaving things lying around
.DS_Store
Thumbs.db
*.swp
